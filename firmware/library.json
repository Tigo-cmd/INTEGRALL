{
  "name": "Integrall",
  "version": "1.1.0",
  "description": "Unified IoT firmware framework for ESP32, ESP8266, and Arduino - simplifies hardware integration and backend communication",
  "keywords": "iot, esp32, esp8266, arduino, framework, relay, keypad, oled, lcd, sensors, servo, camera, automation",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tigo-cmd/INTEGRALL.git"
  },
  "authors": [
    {
      "name": "Emmanuel TIGO",
      "email": "emmanuel@example.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://integrall.io",
  "dependencies": {
    "bblanchon/ArduinoJson": "^7.0.0"
  },
  "frameworks": "arduino",
  "platforms": ["espressif32", "espressif8266", "atmelavr"],
  "examples": [
    {
      "name": "Basic Relay Control",
      "base": "examples/BasicRelay",
      "files": ["BasicRelay.ino"]
    },
    {
      "name": "Keypad Lock System",
      "base": "examples/KeypadLock",
      "files": ["KeypadLock.ino"]
    },
    {
      "name": "Full Demo",
      "base": "examples/FullDemo",
      "files": ["FullDemo.ino"]
    }
  ]
}
