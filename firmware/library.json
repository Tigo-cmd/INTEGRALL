      "files": [
        "KeypadLock.ino"
      ]
    },
    {
      "name": "CloudMQTT",
      "base": "examples/CloudMQTT",
      "files": [
        "CloudMQTT.ino"
      ]
    },
    {
      "name": "SerialOnlyTest",
      "base": "examples/SerialOnlyTest",
      "files": [
        "SerialOnlyTest.ino"
      ]
    },
    {
      "name": "FullDemo",
      "base": "examples/FullDemo",
      "files": [
        "FullDemo.ino"
      ]
    }
  ]
}
